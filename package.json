{
  "name": "hojicha-launcher",
  "productName": "Hojicha Launcher",
  "version": "0.6.5",
  "private": true,
  "description": "Minecraft: Java Edition launcher with instances, Modrinth downloads, instance syncing and local servers",
  "author": "Quinten",
  "license": "MIT",
  "homepage": "https://github.com/Qu1nten/hojicha-launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qu1nten/hojicha-launcher.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron build/render-icon.js",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish never && node build/release.js",
    "release:upload": "node build/release.js"
  },
  "build": {
    "appId": "com.hojicha.launcher",
    "productName": "Hojicha Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon-matcha.png",
      "build/icon.ico"
    ],
    "afterPack": "build/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "Qu1nten",
        "repo": "hojicha-launcher"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Hojicha-Launcher-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hojicha Launcher",
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
